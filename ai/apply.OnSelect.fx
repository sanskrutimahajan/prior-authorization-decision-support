If(chkAIConfirm.Value && varAIScope && !varAIBusy && ddAIimagingAvailable.Selected.Value<>"Unknown" && ddAImedicationTrial.Selected.Value<>"Unknown" && ddAIspecialistEvaluation.Selected.Value<>"Unknown" && ddAIfunctionalLimitation.Selected.Value<>"Unknown" && ddAIconservativeTreatmentFailed.Selected.Value<>"Unknown" && !IsBlank(txtAIphysicalTherapyWeeks.Text) && !IsBlank(txtAIsymptomsDurationMonths.Text) && IfError(Value(txtAIphysicalTherapyWeeks.Text)>=0 && Value(txtAIsymptomsDurationMonths.Text)>=0,false) && IfError(Mod(Value(txtAIphysicalTherapyWeeks.Text),1)=0 && Mod(Value(txtAIsymptomsDurationMonths.Text),1)=0,false) && varAIConfirmed && varAIReviewFingerprint=(ddAIimagingAvailable.Selected.Value & "|" & ddAImedicationTrial.Selected.Value & "|" & ddAIspecialistEvaluation.Selected.Value & "|" & ddAIfunctionalLimitation.Selected.Value & "|" & ddAIconservativeTreatmentFailed.Selected.Value & "|" & txtAIphysicalTherapyWeeks.Text & "|" & txtAIsymptomsDurationMonths.Text & "|" & txtAIDocument.Text),IfError(Set(varSelectedCase,Patch('Prior Authorization Cases',varSelectedCase,{'Imaging Available':ddAIimagingAvailable.Selected.Value="Yes",'Medication Trial':ddAImedicationTrial.Selected.Value="Yes",'Specialist Evaluation':ddAIspecialistEvaluation.Selected.Value="Yes",'Functional Limitation':ddAIfunctionalLimitation.Selected.Value="Yes",'Conservative Treatment Failed':ddAIconservativeTreatmentFailed.Selected.Value="Yes",'Physical Therapy Weeks':Value(txtAIphysicalTherapyWeeks.Text),'Symptoms Duration Months':Value(txtAIsymptomsDurationMonths.Text)})); Set(varAnalyzed,false); Clear(colAuthorizationResults); Notify("Reviewed evidence saved. Analyze requirements before a decision.",NotificationType.Success); Navigate(scrCaseDetails,ScreenTransition.None),Notify("Evidence could not be saved. Try again.",NotificationType.Error)))
