Sort(Filter('Prior Authorization Cases', (IsBlank(Trim(TextInput4.Text)) || StartsWith('Case Number', Trim(TextInput4.Text)) || StartsWith('Patient Name', Trim(TextInput4.Text))) && (Dropdown4.Selected.Value = "All statuses" || (Dropdown4.Selected.Value = "Pending" && 'Status (cr36f_status)' = 'Status (Prior Authorization Cases)'.Pending) || (Dropdown4.Selected.Value = "In Review" && 'Status (cr36f_status)' = 'Status (Prior Authorization Cases)'.'In Review') || (Dropdown4.Selected.Value = "Approved" && 'Status (cr36f_status)' = 'Status (Prior Authorization Cases)'.Approved) || (Dropdown4.Selected.Value = "Denied" && 'Status (cr36f_status)' = 'Status (Prior Authorization Cases)'.Denied)) && (Dropdown5.Selected.Value = "All payers" || Payer = Dropdown5.Selected.Value) && (IsBlank(Trim(TextInput5.Text)) || StartsWith('Assigned Reviewer', Trim(TextInput5.Text))) && (Dropdown6.Selected.Value = "All urgency" || (Dropdown6.Selected.Value = "Urgent" && Urgent = true) || (Dropdown6.Selected.Value = "Routine" && Urgent = false))), 'Case Number', SortOrder.Ascending)
