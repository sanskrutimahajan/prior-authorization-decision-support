With({events: Sort(Filter('Authorization Decisions', 'Authorization Case'.'Prior Authorization Case' = varSelectedCase.'Prior Authorization Case'), 'Decision Time', SortOrder.Descending)}, If(IsEmpty(events), "No recorded decisions yet.", Concat(events, Text(DateAdd('Decision Time', TimeZoneOffset('Decision Time'), TimeUnit.Minutes), "yyyy-mm-dd HH:mm:ss") & " UTC | " & 'Previous Status' & " → " & 'New Status' & " [" & Outcome & "]" & Char(10) & "Reviewer: " & Reviewer & Char(10) & "Reason: " & Reason & If(!IsBlank('Reviewer Notes'), Char(10) & "Notes: " & 'Reviewer Notes', ""), Char(10) & Char(10))))
