IfError(ForAll(Filter('Prior Authorization Cases', !IsBlank('Decision History')) As c, ForAll(Filter(Split(c.'Decision History', Char(10) & Char(10)), !IsBlank(Trim(Value))) As entry, With({lines: Split(entry.Value, Char(10)), header: First(Split(entry.Value, Char(10))).Value}, With({stamp: Left(header, 19), transition: Last(Split(header, " UTC | ")).Value}, With({oldState: First(Split(transition, " → ")).Value, newState: Last(Split(transition, " → ")).Value, eventName: Text(c.'Prior Authorization Case') & "|" & stamp & "|" & Last(Split(transition, " → ")).Value}, If(IsBlank(LookUp('Authorization Decisions', 'Decision Name' = eventName)), Patch('Authorization Decisions', Defaults('Authorization Decisions'), {'Decision Name': eventName, 'Authorization Case': c, 'Decision Time': DateAdd(DateTimeValue(stamp, "en-US"), -TimeZoneOffset(DateTimeValue(stamp, "en-US")), TimeUnit.Minutes), 'Previous Status': oldState, 'New Status': newState, Reviewer: Substitute(LookUp(lines, StartsWith(Value, "Reviewer: ")).Value, "Reviewer: ", ""), Reason: Substitute(LookUp(lines, StartsWith(Value, "Reason: ")).Value, "Reason: ", ""), 'Reviewer Notes': Substitute(LookUp(lines, StartsWith(Value, "Notes: ")).Value, "Notes: ", ""), Outcome: "Applied"}))))))); Refresh('Authorization Decisions'); Notify("Existing decision history migrated.", NotificationType.Success), Notify("History migration failed. Original history is retained.", NotificationType.Error))
