IfError(
ForAll(Table({P:"Aetna",T:"Lumbar Epidural Steroid Injection",D:"Lumbar Radiculopathy",S:"Full"},{P:"Blue Cross",T:"Lumbar Radiculopathy",D:"Lumbar Radiculopathy",S:"Full"},{P:"United Health",T:"Total Knee Replacement",D:"Knee Osteoarthritis",S:"Full"},{P:"Blue Cross",T:"Xray",D:"Fracture",S:"Imaging"},{P:"Cigna",T:"Radiology",D:"Fracture",S:"Imaging"},{P:"Cigna",T:"Chemo Therapy",D:"Breast Cancer",S:"Specialist"}) As combo,
ForAll(Filter(Table({N:"Confirmed Diagnosis",M:0,E:"Demo diagnosis entry"},{N:"Imaging Available",M:0,E:"Demo imaging flag"},{N:"Physical Therapy",M:6,E:"Demo completed weeks"},{N:"Medication Trial",M:0,E:"Demo medication flag"},{N:"Specialist Evaluation",M:0,E:"Demo specialist flag"},{N:"Symptoms Duration",M:3,E:"Demo symptom months"},{N:"Functional Limitation",M:0,E:"Demo functional limitation flag"},{N:"Conservative Treatment Failed",M:0,E:"Demo conservative treatment flag"}), combo.S="Full" || N="Confirmed Diagnosis" || N="Specialist Evaluation" || (combo.S="Imaging" && N="Imaging Available")) As r,
Patch('Prior Authorization Requirements', Coalesce(LookUp('Prior Authorization Requirements',Payer=combo.P && Treatment=combo.T && Diagnosis=combo.D && 'Requirement Name'=r.N),Defaults('Prior Authorization Requirements')),{'Requirement Name':r.N,Payer:combo.P,Treatment:combo.T,Diagnosis:combo.D,'Minimum Duration':r.M,'Required Evidence':r.E,'Requirement Description':"Demo demo rule; not a real payer policy or clinical guidance.",'Is Required':true,Active:true}))) ;
ClearCollect(colDemoCases,Filter('Prior Authorization Cases','Case Number' in ["CA001","CA002","CA003","CA004","CA005"])); ForAll(colDemoCases As c,Patch('Prior Authorization Cases',c,{'Patient Name':"Demo Patient " & Right(c.'Case Number',3),'Assigned Reviewer':"reviewer@example.com",'Clinical Notes':"Demo learning case. No real patient data."}));
Refresh('Prior Authorization Requirements');Refresh('Prior Authorization Cases');Notify("Demo demo rules and reviewers saved.",NotificationType.Success),Notify("Demo setup failed.",NotificationType.Error))