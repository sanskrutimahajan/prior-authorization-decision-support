If(IsBlank(txtPTWeeks.Text) || IsBlank(txtSymptomMonths.Text) || Value(txtPTWeeks.Text) < 0 || Value(txtSymptomMonths.Text) < 0 || Mod(Value(txtPTWeeks.Text),1) <> 0 || Mod(Value(txtSymptomMonths.Text),1) <> 0, Notify("Enter non-negative whole numbers for both durations.", NotificationType.Error), IfError(Set(varSelectedCase, Patch('Prior Authorization Cases', varSelectedCase, {'Physical Therapy Weeks': Value(txtPTWeeks.Text), 'Symptoms Duration Months': Value(txtSymptomMonths.Text), 'Imaging Available': chkImaging.Value, 'Medication Trial': chkMedication.Value, 'Specialist Evaluation': chkSpecialist.Value, 'Functional Limitation': chkFunction.Value, 'Conservative Treatment Failed': chkConservative.Value, 'Assigned Reviewer': Trim(txtAssignedReviewer.Text)})); ClearCollect(colAuthorizationResults, AddColumns(Filter('Prior Authorization Requirements', Payer = varSelectedCase.Payer && Treatment = varSelectedCase.Treatment && Diagnosis = varSelectedCase.Diagnosis && Active = true) As rule, Result, If(Switch(rule.'Requirement Name', "Confirmed Diagnosis", !IsBlank(Trim(varSelectedCase.Diagnosis)), "Imaging Available", varSelectedCase.'Imaging Available' = true, "Physical Therapy", !IsBlank(varSelectedCase.'Physical Therapy Weeks') && varSelectedCase.'Physical Therapy Weeks' >= rule.'Minimum Duration', "Medication Trial", varSelectedCase.'Medication Trial' = true, "Specialist Evaluation", varSelectedCase.'Specialist Evaluation' = true, "Symptoms Duration", !IsBlank(varSelectedCase.'Symptoms Duration Months') && varSelectedCase.'Symptoms Duration Months' >= rule.'Minimum Duration', "Functional Limitation", varSelectedCase.'Functional Limitation' = true, "Conservative Treatment Failed", varSelectedCase.'Conservative Treatment Failed' = true, false), "Met", "Missing"))); Set(varAnalyzed, true), Notify("Could not save or analyze. Please retry.", NotificationType.Error)))